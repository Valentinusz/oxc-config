{
  "name": "oxc-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Oxc configuration for my projects",
  "type": "module",
  "scripts": {
    "packages:build": "pnpm --recursive --aggregate-output exec vite build",
    "packages:publish": "pnpm --recursive publish --no-git-checks --provenance",
    "fmt:format": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint",
    "typescript:check": "pnpm --recursive --aggregate-output exec tsc --noEmit",
    "verify": "pnpm run fmt:check && pnpm run lint:check && pnpm run typescript:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@valentinusz/oxfmt-config": "workspace:*",
    "@valentinusz/oxlint-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "catalog:"
  }
}
